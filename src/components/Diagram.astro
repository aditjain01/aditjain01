---
import type { DiagramData } from '../diagrams/types';
import { routeEdge, toPath, labelPoint, endAngle } from '../diagrams/route';

interface Props {
  data: DiagramData;
  hero?: boolean;
}
const { data, hero = false } = Astro.props;
const byId = new Map(data.nodes.map((n) => [n.id, n]));
const uid = `d-${data.id}`;

const edges = (data.edges ?? []).map((e) => {
  const a = byId.get(e.from);
  const b = byId.get(e.to);
  if (!a || !b) throw new Error(`Diagram ${data.id}: unknown node in edge ${e.from} -> ${e.to}`);
  const pts = routeEdge(e, a, b);
  const lp = e.label ? labelPoint(pts) : null;
  const lw = e.label ? e.label.length * 6.2 + 8 : 0;
  return {
    ...e,
    d: toPath(pts),
    end: pts[pts.length - 1],
    endAngle: endAngle(pts),
    start: pts[0],
    startAngle: endAngle(pts, true),
    lp,
    lw,
  };
});
const noted = data.nodes.filter((n) => n.note);
---

<figure class="diagram" data-diagram={uid}>
  <div class="diagram-scroll" tabindex="0" role="region" aria-label={`${data.title} (scrolls sideways on narrow screens)`}>
    <svg viewBox={`0 0 ${data.width} ${data.height}`} role="group" aria-label={data.title} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <path id={`${uid}-head`} class="d-arrow" d="M0 0 L-8 -3.5 L-8 3.5 Z" />
      </defs>

      {
        (data.groups ?? []).map((g) => (
          <g>
            <rect class={`d-group ${g.kind ?? 'layer'}`} x={g.x} y={g.y} width={g.w} height={g.h} rx="4" />
            <text class="d-group-label" x={g.x + 14} y={g.labelBottom ? g.y + g.h - 10 : g.y + 20}>
              {g.label}
            </text>
          </g>
        ))
      }

      {
        edges.map((e) => (
          <g>
            <path class={`d-edge ${e.dashed ? 'dashed' : ''}`} d={e.d} />
            <use href={`#${uid}-head`} transform={`translate(${e.end[0]} ${e.end[1]}) rotate(${e.endAngle})`} />
            {e.bidir && <use href={`#${uid}-head`} transform={`translate(${e.start[0]} ${e.start[1]}) rotate(${e.startAngle})`} />}
            {e.lp && (
              <g>
                <rect class="d-edge-bg" x={e.lp[0] - e.lw / 2} y={e.lp[1] - 8} width={e.lw} height="16" />
                <text class="d-edge-label" x={e.lp[0]} y={e.lp[1]} text-anchor="middle" dominant-baseline="central">
                  {e.label}
                </text>
              </g>
            )}
          </g>
        ))
      }

      {
        data.nodes.map((n) => {
          const cx = n.x + n.w / 2;
          const cy = n.y + n.h / 2;
          const interactive = Boolean(n.note);
          return (
            <g
              class={`d-node ${n.ramp ?? 'gray'} ${interactive ? 'has-note' : ''}`}
              tabindex={interactive ? 0 : undefined}
              role={interactive ? 'button' : undefined}
              aria-label={interactive ? `${n.title}. ${n.note}` : undefined}
              data-title={n.title}
              data-note={n.note}
            >
              <rect class="d-box" x={n.x} y={n.y} width={n.w} height={n.h} rx="3" />
              <text class="d-title" x={cx} y={n.sub ? cy - 7 : cy} text-anchor="middle" dominant-baseline="central">
                {n.title}
              </text>
              {n.sub && (
                <text class="d-sub" x={cx} y={cy + 10} text-anchor="middle" dominant-baseline="central">
                  {n.sub}
                </text>
              )}
            </g>
          );
        })
      }
    </svg>
  </div>
  {noted.length > 0 && <p class="diagram-note" aria-live="polite" data-note-panel>Hover, focus or tap a box for a short note.</p>}
  <figcaption>{data.caption}</figcaption>
  {
    noted.length > 0 && (
      <details class="diagram-text">
        <summary>Diagram notes as text</summary>
        <ul>
          {noted.map((n) => (
            <li>
              <strong>{n.title}.</strong> {n.note}
            </li>
          ))}
        </ul>
      </details>
    )
  }
</figure>

<script>
  const show = (node: Element) => {
    const fig = node.closest('.diagram');
    const panel = fig?.querySelector('[data-note-panel]');
    if (!fig || !panel) return;
    fig.querySelectorAll('.d-node.is-active').forEach((n) => n.classList.remove('is-active'));
    node.classList.add('is-active');
    const strong = document.createElement('strong');
    strong.textContent = `${node.getAttribute('data-title')}. `;
    panel.replaceChildren(strong, document.createTextNode(node.getAttribute('data-note') ?? ''));
  };
  const target = (e: Event) => (e.target as Element | null)?.closest?.('.d-node.has-note') ?? null;
  for (const type of ['mouseover', 'focusin', 'click']) {
    document.addEventListener(type, (e) => {
      const n = target(e);
      if (n) show(n);
    });
  }
  document.addEventListener('keydown', (e) => {
    const n = target(e);
    if (n && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      show(n);
    }
  });
</script>
