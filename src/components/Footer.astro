---
import { site, isTodo } from '../data/site';
import { url } from '../utils/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>© {year} {site.name}</p>
    <ul>
      <li><a href={site.github} rel="me">GitHub</a></li>
      {!isTodo(site.linkedin) && <li><a href={site.linkedin} rel="me">LinkedIn</a></li>}
      <li><a href={url('/rss.xml')}>RSS</a></li>
    </ul>
  </div>
</footer>
